{
  "name": "@toss-place/shell",
  "version": "0.1.0",
  "description": "매장용 미니 POS 데스크톱 셸",
  "author": "ganimjeong",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsdown && node scripts/copyBundles.ts",
    "dev": "tsdown && BUNDLE_DEV=1 electron .",
    "start": "electron .",
    "package": "electron-builder --publish never",
    "smoke": "electron . --smoke-test",
    "measure": "node scripts/measure.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@toss-place/cash": "workspace:^",
    "@toss-place/order": "workspace:^",
    "@toss-place/pos-bridge": "workspace:^",
    "@toss-place/tsconfig": "workspace:^",
    "@types/node": "^24.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "tsdown": "^0.23.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
